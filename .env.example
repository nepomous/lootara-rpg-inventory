# Variáveis de ambiente do Lootara - RPG Inventory
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no git

# ── RevenueCat ──────────────────────────────────────────
# Chave pública do projeto no RevenueCat (Android)
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# Chave pública do projeto no RevenueCat (iOS)
EXPO_PUBLIC_REVENUECAT_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google AdMob ─────────────────────────────────────────
# App ID do AdMob (Android) — formato: ca-app-pub-XXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# App ID do AdMob (iOS) — formato: ca-app-pub-XXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Banner Ad Unit ID (Android) — formato: ca-app-pub-XXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ── EAS Build ────────────────────────────────────────────
# ID do projeto no EAS (obtenha em https://expo.dev)
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
