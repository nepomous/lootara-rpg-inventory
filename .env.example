# Variáveis de ambiente do Lootara - RPG Inventory
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no git

# ── RevenueCat ──────────────────────────────────────────
# Chave pública do projeto no RevenueCat (Android) — começa com "goog_"
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Chave pública do projeto no RevenueCat (iOS) — começa com "appl_"
EXPO_PUBLIC_REVENUECAT_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google AdMob ─────────────────────────────────────────
# App ID do AdMob (Android) — formato: ca-app-pub-XXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713

# App ID do AdMob (iOS) — formato: ca-app-pub-XXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511

# Banner Ad Unit ID para a tela Home (Android/iOS compartilham o mesmo valor em teste)
EXPO_PUBLIC_ADMOB_BANNER_HOME=ca-app-pub-3940256099942544/6300978111

# Banner Ad Unit ID para a tela de Sacola do Personagem
EXPO_PUBLIC_ADMOB_BANNER_CHARACTER=ca-app-pub-3940256099942544/6300978111

# Rewarded Ad Unit ID — usado na Biblioteca para desbloquear descrição de itens raros
EXPO_PUBLIC_ADMOB_REWARDED=ca-app-pub-3940256099942544/5224354917
# Valores acima são IDs de TESTE oficiais do Google — substitua pelos seus em produção

# ── Flags de Teste (somente desenvolvimento) ────────────
# Força o status premium sem passar pelo RevenueCat.
# SÓ funciona em builds __DEV__ — em produção é ignorado.
# NUNCA defina como true em .env de produção.
EXPO_PUBLIC_FORCE_PREMIUM=false

# ── EAS Build ────────────────────────────────────────────
# ID do projeto no EAS (obtenha em https://expo.dev)
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
