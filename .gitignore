# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase / Google Cloud (nunca commitar — contêm chaves privadas)
google-services.json
GoogleService-Info.plist
service-account.json

# local env files
.env
.env.local
.env.production
.env.staging
.env*.local

# Security audit (contém riscos aceitos — não commitar em repos públicos)
docs/SECURITY_AUDIT.md

# Android release signing — NEVER commit keystore or credentials
android/keystore.properties
android/app/*.jks
android/app/*.keystore
!android/app/debug.keystore

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# notas pessoais locais
.notes
